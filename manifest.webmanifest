{
  "id": "./",
  "name": "Spieleabend",
  "short_name": "Spieleabend",
  "description": "Eure Spiele-App: Wer bin ich, Quizwand und mehr.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1d1730",
